.env
*.db
*.db-shm
*.db-wal
config.yaml
trust.yaml
bin/*
!bin/config.yaml.example
!bin/mcp.yaml.example
!bin/skills/
# bin/skills/ is the dev/lane home's live skills dir: ONE shipped skill is
# tracked product (learn-skill, with its scripts/), everything else in it is
# runtime state - agent-created skills, .curator/ (usage.json, ledger.jsonl,
# backups/), .archive/, and the delegate workaround dirs. Whitelist polarity:
# ignore every child, re-include the shipped product by name, so a dev
# checkout shows ZERO untracked skills noise without a blanket ignore that
# would hide the tracked skill (finding C2, t_a48be895).
bin/skills/*
!bin/skills/.gitkeep
!bin/skills/learn-skill/
# the git fence shim is product code shipped by the repo (t_8b32a09a)
!bin/shims/
!bin/shims/**
data/

# Improvement loop temp files
tmp/
scripts/improve-gates.sh
scripts/improve-commit.sh

# Go
*.exe
*.test
*.prof
coverage.out

# IDE
.idea/
.vscode/
*.swp

# Kanban worktrees
.worktrees/

# WebUI (Nuxt, at the repo root since restructure part 2 - t_905fa502)
webui/node_modules
webui/.nuxt/
webui/.output/
webui/dist/
webui/.data/
# generated at config-eval time by nuxt.config.ts (module-panels)
webui/app/composables/module-panels.generated.ts
*.log
npm-debug.log*

# NOTE: engine/http_channel/static/ IS tracked - the built SPA is
# committed so go install / go build produce the complete product
# (placeholder-era ignore rules removed; see webui/scripts/build.sh)

# dev-instance first-run bootstrap writes its own copies into bin/
bin/*.example

# stray root build artifact (go build ./cmd/omega without -o)
/omega
.nuxt/
