# omega-agent gateway configuration.
# Copy to config.yaml and edit. Every value can be overridden by an
# OMEGA_* environment variable (see below).

provider:
  # Provider type: ollama (default), openai, or anthropic.
  # For openai, host defaults to https://api.openai.com/v1; for
  # anthropic, https://api.anthropic.com/v1.
  type: ollama
  # Required. The model to use.
  model_name: llama3
  # Base URL. Ollama default: http://localhost:11434
  host: http://localhost:11434
  # API key for openai/anthropic. Falls back to OPENAI_API_KEY or
  # ANTHROPIC_API_KEY. Ignored by ollama.
  api_key:

server:
  # HTTP listen port. Default: 8099
  port: 8099

store:
  # SQLite database path for the session store. Default: omega.db
  db_path: omega.db

compaction:
  # Summarize old messages when the conversation nears the context
  # window. Default: enabled.
  enabled: true
  # Fraction of the context window at which compaction triggers.
  # Default: 0.8
  threshold: 0.8
  # Messages preserved verbatim at the start and end of the history.
  # Default: 2 first, 10 last.
  keep_first: 2
  keep_last: 10

# Environment variable overrides (take precedence over this file):
#   OMEGA_PROVIDER  -> provider.type
#   OMEGA_API_KEY   -> provider.api_key
#   OMEGA_MODEL     -> provider.model_name
#   OMEGA_HOST      -> provider.host
#   OMEGA_PORT      -> server.port
#   OMEGA_DB_PATH   -> store.db_path
#   OMEGA_COMPACTION_THRESHOLD -> compaction.threshold
