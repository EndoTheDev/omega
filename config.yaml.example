# omega-agent gateway configuration.
# Copy to config.yaml and edit. Every value can be overridden by an
# OMEGA_* environment variable (see below).

provider:
  # Required. The Ollama model to use.
  model_name: llama3
  # Ollama base URL. Default: http://localhost:11434
  host: http://localhost:11434

server:
  # HTTP listen port. Default: 8099
  port: 8099

store:
  # SQLite database path for the session store. Default: omega.db
  db_path: omega.db

# Environment variable overrides (take precedence over this file):
#   OMEGA_MODEL     -> provider.model_name
#   OMEGA_HOST      -> provider.host
#   OMEGA_PORT      -> server.port
#   OMEGA_DB_PATH   -> store.db_path
