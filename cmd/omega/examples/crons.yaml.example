# Omega cron jobs. Copy to crons.yaml and edit.
# Place in OMEGA_HOME (binary directory, or ~/.omega/).
#
# Schedules are standard 5-field cron (minute hour day month weekday),
# evaluated in the server's local time. No seconds, no @descriptors.
# Each fire runs the prompt as a full agent turn in a session labeled
# cron:<name>.
#
# Two job kinds:
#   kind: cron (default)  - schedule is the 5-field grammar above.
#   kind: interval        - minutes is an integer >= 1; the job fires
#                           every N minutes on the minute grid.
#
# The defaulting law: an `agent` field left empty runs the fire under
# the default agent; a `model` field left empty uses the session's
# provider model. Empty = inherit, never an error. A bad agent name is
# a clear error in the job log when it fires - the scheduler keeps
# standing.
#
# deliver targets (where the fire lands, one field for the whole shape):
#   new-session       - fresh session, the default (runs in-process)
#   continuous-agent  - a WAKE into an existing continuous agent
#                       session (set agent: <name> to an agent home;
#                       the fire goes through the event spine)
#   append-to-file    - the run's final message appends to `file`
#                       (home-relative); empty file = journal
#                       naming (<OMEGA_HOME>/journal/YYYY-MM-DD.md)
#
# Legacy values (deprecated, still accepted): none (= new-session),
# journal (= append-to-file with the journal naming), memory.
#
# omega can propose jobs in conversation but never writes this file
# itself - copy it by hand, or edit jobs in the webui Cron tab (the
# editor writes this file the same way the toggle route does).
#
# jobs:
#   - name: daily-journal        # required, unique, [a-z0-9-]
#     kind: cron                 # cron | interval, default cron
#     schedule: "0 8 * * *"      # required iff kind cron, 5-field
#     minutes: 5                 # required iff kind interval, >= 1
#     agent: scout               # optional; empty = default agent
#     model: glm-5.3             # optional; empty = session model
#     prompt: "..."              # required, the user message the run sends
#     skills:                    # optional; the named skills' bodies ride
#       - omega-dev              # the fire prompt ahead of the prompt
#     deliver: new-session       # new-session | continuous-agent | append-to-file
#     file: notes/report.md      # the append-to-file target (home-relative)
#     enabled: true              # default true

jobs:
  - name: daily-journal
    schedule: "0 8 * * *"
    prompt: "Summarize yesterday's omega sessions into a concise daily journal entry - what happened, notable token usage, anything worth remembering."
    deliver: journal

  - name: insights-digest
    schedule: "0 9 * * 0"
    prompt: "Compute a weekly usage digest from the /sessions data - token totals per session, activity by day, patterns or anomalies worth flagging. Report only."

  - name: backup
    schedule: "0 3 * * *"
    prompt: "Backup this omega home: copy omega.db and config.yaml into <OMEGA_HOME>/backups/<today's date>/ (create the directory if missing), then keep only the 14 newest backup directories and report what was copied and pruned."

  - name: session-hygiene
    schedule: "0 3 * * *"
    # The REAL hygiene pass: one agent turn calling the sessions.hygiene
    # tool (summarize settled sessions, prune past retention, vacuum the
    # database; the knobs live in config.yaml's `sessions:` section).
    # DISABLED BY DEFAULT: live jobs stay off until omega is the daily
    # driver. Flip enabled: true (or the Cron tab's toggle) by hand -
    # never let a background job be born on.
    enabled: false
    prompt: "Run this omega home's session hygiene pass: call the sessions.hygiene tool with no arguments and relay the counts report it returns."

  - name: improver-reflection
    schedule: "30 4 * * 0"
    prompt: "Reflect on the omega codebase's state this week and propose a short list of concrete next improvements as a written proposal in this session only - no file edits, no crons.yaml changes, propose don't apply."
